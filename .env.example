# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value here has a working default for local
# development, so the only one you may actually want to set is the API key.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local docker-compose Postgres:
DATABASE_URL=postgresql+asyncpg://supervisor:supervisor@localhost:5432/order_supervisor
# Supabase (Connection string -> URI, swap the driver and keep sslmode):
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require

# --- Temporal -------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-supervisor

# --- LLM ------------------------------------------------------------------
# auto = live when GEMINI_API_KEY is set, otherwise the deterministic
#        policy. mock = force the policy. live = require the API.
LLM_MODE=auto
GEMINI_API_KEY=
# Fallback provider, tried once when the primary model errors.
GROQ_API_KEY=

AGENT_MODEL=gemini-3.5-flash
CLASSIFIER_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=openai/gpt-oss-120b
AGENT_EFFORT=medium

# --- Workflow defaults ----------------------------------------------------
DEFAULT_WAKE_SECONDS=900
DEFAULT_MAX_RUN_AGE_SECONDS=604800
MEMORY_COMPACTION_THRESHOLD=12

# --- API ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
